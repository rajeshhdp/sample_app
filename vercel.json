{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/quizzes/:id",       "destination": "/api/quizzes?id=:id" },
    { "source": "/api/responses/:quizId", "destination": "/api/responses?quizId=:quizId" },
    { "source": "/(.*)",                  "destination": "/index.html" }
  ]
}
